# Основной бэкенд (REST API портала)
VITE_BACK_BACK_SERVER = ""

# Публичный API (без авторизации)
VITE_BACK_API_SERVER = ""
# Комментируем, если используется основной бэкенд
# VITE_BACK_BACK_SERVER = ""

VITE_BACK_SITE_MOSOBLENERGO_SERVER = ""
VITE_BACK_SERVER_TEST = ""

# local OR test OR beta — управляет видимостью робота-консультанта и отладки
VITE_BACK_VERSION = "local"

# Флаг блокировки отправки заявок
# VITE_BACK_BLOCK_SEND_CLAIM = 1

# Проверка ЭП через e-trust (без него lib/checkSig.js не работает)
VITE_BACK_CHECKSIG_SERVER = ""

# Робот-консультант (n8n). Единый вебхук для всех чатов: без него чат не отправляет сообщения
VITE_N8N_WEBHOOK_URL = ""

# ⚠️ ВНИМАНИЕ: всё с префиксом VITE_ попадает в собранный JS-бандл и видно в браузере.
# Секреты (API-ключи платных сервисов) здесь хранить нельзя — только через бэкенд-прокси.
